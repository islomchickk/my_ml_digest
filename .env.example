# Telegram
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_CHANNEL_ID=

# LLM provider: claude | openai | gemini | openrouter | neuraldeep
LLM_PROVIDER=neuraldeep
LLM_MODEL=qwen3.6-unlim
NEURALDEEP_MAX_OUTPUT_TOKENS=8000
NEURALDEEP_ENABLE_THINKING=false
NEURALDEEP_THINKING_TOKEN_BUDGET=1024

# API keys (fill in only the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NEURALDEEP_API_KEY=

# Parser
FETCH_HABR_STATS=true
HABR_STATS_LIMIT=50
